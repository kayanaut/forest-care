<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forestcare_gateway</name>
  <version>0.1.0</version>
  <description>
    Records rover data (camera, GNSS, odometry, IMU, LiDAR, detections, operator marks) into
    Forest Care mission packages and uploads them to the Forest Care API. Hardware-independent.
  </description>
  <maintainer email="maintainer@example.org">Forest Care Bonn</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <!-- optional: only needed when a perception node publishes detections -->
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
